# ---- eBPF / CO-RE generated artifacts (never commit these) ----
# vmlinux.h is dumped from YOUR kernel's BTF at build time — machine-specific
vmlinux.h
# Compiled BPF objects and generated skeleton headers
*.bpf.o
*.skel.h

# ---- C build output ----
*.o
*.a
*.so
*.d
# The compiled collector binary (add other binaries here as the project grows)
collector/collector

# ---- Captured data ----
# Raw telemetry sessions can be large and are regenerated by running the collector.
# Keep the directory in git (via .gitkeep) but ignore its contents.
data/raw/*
!data/raw/.gitkeep
*.jsonl

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# ---- Editor / OS / VM cruft ----
.vscode/
.idea/
*.swp
*~
.DS_Store

data/features/*.csv
data/features/*.joblib

data/features/*.onnx
data/features/*.joblib
data/features/*.csv
